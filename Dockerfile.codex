FROM python:3.12-slim-trixie AS codex-builder

ARG APT_MIRROR_URL=
ARG APT_SECURITY_MIRROR_URL=

COPY docker/apt_mirror_sources.sh /usr/local/bin/apt_mirror_sources.sh

RUN sh /usr/local/bin/apt_mirror_sources.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates nodejs npm \
    && rm -rf /var/lib/apt/lists/*

ARG CODEX_VERSION=0.130.0
ARG NPM_CONFIG_REGISTRY=

RUN if [ -n "$NPM_CONFIG_REGISTRY" ]; then \
        npm install -g --include=optional --registry "$NPM_CONFIG_REGISTRY" "@openai/codex@${CODEX_VERSION}"; \
    else \
        npm install -g --include=optional "@openai/codex@${CODEX_VERSION}"; \
    fi \
    && codex --version

FROM python:3.12-slim-trixie AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

ARG APT_MIRROR_URL=
ARG APT_SECURITY_MIRROR_URL=

COPY docker/apt_mirror_sources.sh /usr/local/bin/apt_mirror_sources.sh

RUN sh /usr/local/bin/apt_mirror_sources.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git jq nodejs ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/bin/apt_mirror_sources.sh

COPY --from=codex-builder /usr/local/lib/node_modules/@openai/codex /usr/local/lib/node_modules/@openai/codex
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && codex --version

# Install uv for skills/scripts that invoke `uv run` inside the container.
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /usr/local/bin/
RUN uv --version

WORKDIR /app

ARG PIP_INDEX_URL=
ARG PIP_EXTRA_INDEX_URL=
ARG PIP_TRUSTED_HOST=

COPY requirements.txt ./
RUN PIP_INDEX_URL="$PIP_INDEX_URL" \
    PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" \
    PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" \
    python -m pip install --upgrade pip \
    && PIP_INDEX_URL="$PIP_INDEX_URL" \
    PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" \
    PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" \
    python -m pip install -r requirements.txt

COPY src ./src
COPY docs/*system-prompt*.md ./docs/

COPY docker/entrypoint.py /usr/local/bin/docker-entrypoint.py

RUN useradd -m -u 1000 -s /bin/bash app \
    && mkdir -p /app/data /app/working_dir /home/app/.codex \
    && chown -R app:app /app /home/app

ENV HOME=/home/app \
    CODEX_HOME=/home/app/.codex \
    CODEX_BIN=codex \
    APP_UID=1000 \
    APP_GID=1000

EXPOSE 8000

ENTRYPOINT ["python", "/usr/local/bin/docker-entrypoint.py"]
CMD ["sh", "-c", "exec python -m uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
