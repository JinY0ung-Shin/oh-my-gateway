# 인증 방식 (선택 — 명시적 선택)
# 자동 감지를 무시하고 강제하려면 설정한다. 값: cli, api_key
# 미설정 시 사용 가능한 env 변수(ANTHROPIC_AUTH_TOKEN 등)를 기준으로 자동 감지한다.
# CLAUDE_AUTH_METHOD=cli

# Claude Code 환경변수
# Claude Code CLI / Agent SDK에 그대로 전달된다.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=your-auth-token
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-5-20250929
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
# 설정하면 각 이름이 (기본 opus/sonnet/haiku 별칭과 함께) /v1/models에도 노출되고
# 모델 id로 요청할 수 있다. 게이트웨이는 이를 기본 별칭으로 되돌려 매핑하므로
# 실제 별칭 해석은 CLI가 수행한다.

# Anthropic Messages 스트림 sanitizer (선택).
# ANTHROPIC_BASE_URL은 실제 Anthropic 호환 업스트림(예: Docker Compose의
# LiteLLM: http://litellm:4000)을 가리키게 유지한다. 활성화하면 게이트웨이가
# Claude SDK 서브프로세스의 env만 재작성해 Claude가 로컬 sanitizer 라우트를 먼저
# 호출하게 하고, sanitizer가 ANTHROPIC_BASE_URL로 전달한다.
# ANTHROPIC_BASE_URL이 없으면 sanitizer를 켜도 아무 효과가 없다.
# SANITIZER_ENABLED=false
# SANITIZER_REQUEST_TIMEOUT=0
# 업스트림 호출의 TLS 검증. 기본은 켜짐(시스템 CA로 검증).
# "false"로 끄거나(INSECURE — 업스트림이 사설/자체 서명 인증서를 쓰는 신뢰
# 네트워크에서 MITM 위험을 감수할 때만), 파일 경로를 지정해 커스텀 CA 번들을
# 사용한다(끄는 것보다 권장).
# SANITIZER_TLS_VERIFY=true
#
# 업스트림의 자체 Anthropic 어댑터에 의존하지 않고 Anthropic <-> OpenAI 변환을
# 프로세스 안에서 직접 수행한다. 활성화하면 sanitizer 라우트가
# {ANTHROPIC_BASE_URL}/v1/chat/completions 로 전달하며 양방향을 직접 변환한다.
# 업스트림의 Anthropic 어댑터가 tool call이나 reasoning 콘텐츠를 잘못
# 직렬화할 때(예: 일부 LiteLLM 구성) 사용한다. 기본값: false.
# SANITIZER_USE_OPENAI_BRIDGE=false


# API 설정
# API_KEY 미설정 시 서버가 시작할 때 대화형으로 API 키 보호를 묻는다.
# 대화형 프롬프트를 쓰려면 주석 상태로 두고, 고정 API 키를 쓰려면 주석을 해제한다.
# API_KEY=your-optional-api-key-here

# 사용자별 워크스페이스 격리
# 사용자 워크스페이스의 기준 디렉터리 (사용자+백엔드별 {dir}/{user}/{backend}/).
# 미설정 시 호스트별 temp 기반 경로(<tmp>/oh-my-gateway-workspaces)를 쓰며,
# 익명 요청은 세션별 하위 디렉터리를 받고 만료 시 정리된다. 워크스페이스는 빈
# 상태로 시작하고, Claude 설정은 워크스페이스와 무관하게 ~/.claude
# (및 ~/.claude/plugins)에서 로드된다.
#
# Docker에서는 docker-compose.yml이 ./workspaces(호스트)를
# /data/workspaces(컨테이너)로 bind-mount하고 compose environment 블록이
# USER_WORKSPACES_DIR 기본값을 /data/workspaces로 두므로, 사용자별 상태가
# 기본으로 호스트에 영속된다. (compose 기본값이 항상 적용되므로 .env에서 비워
# 둬도 Docker에서는 /data/workspaces로 해석된다 — 바꾸려면 여기 값이나 compose
# environment 블록을 수정한다.)
# USER_WORKSPACES_DIR=/data/workspaces

# 사용자별 워크스페이스 bind mount의 호스트 쪽 경로 (Docker 전용).
# 기본값은 docker-compose.yml 옆의 ./workspaces. 워크스페이스 트리를 호스트의
# 다른 위치(예: /srv/gateway/workspaces)에 두려면 재정의한다.
# compose 파싱 시점에만 읽히며 애플리케이션 자체는 사용하지 않는다.
# USER_WORKSPACES_HOST_DIR=./workspaces

# ---------------------------------------------------------------------------
# 시작 시 셋업 훅 (선택)
# ---------------------------------------------------------------------------
# 컨테이너가 시작될 때마다 플러그인 설치 + 서버 실행 전에 (비특권 app 사용자로,
# fail-fast로) 실행할 스크립트의 절대 경로. ~/.claude/settings.json 작성 같은
# 사내/비공개 셋업에 사용해, 오버레이 이미지가 컨테이너 CMD를 다시 쓰지 않고도
# 셋업을 추가할 수 있게 한다. 스크립트는 이미지 안에 존재해야 한다(bind mount
# 또는 빌드타임 install 훅). 미설정 = 건너뜀.
# GATEWAY_STARTUP_SCRIPT=/usr/local/bin/setup_claude_settings.py

# ---------------------------------------------------------------------------
# 마켓플레이스 플러그인 자동 설치 (admin 패널 관리)
# ---------------------------------------------------------------------------
# 플러그인/마켓플레이스는 admin 대시보드의 Plugins 탭에서 설치·제거하며, 그
# 결과가 manifest JSON(아래 CLAUDE_PLUGIN_MANIFEST)에 기록된다. 컨테이너가
# 시작될 때마다 install_plugins.py가 manifest의 각 added 항목에 대해 이전
# clone을 제거하고 `git clone --depth 1 --branch <branch>`(branch 기본 main)를
# 다시 실행한 뒤 `claude plugin marketplace add`, `claude plugin install` +
# `claude plugin update`를 실행해 항상 최신 버전이 설치되게 하고, removed
# 항목은 반대로 uninstall을 적용한다. 그래서 admin에서 한 변경이 컨테이너
# 재시작과 `docker compose down -v`(claude_home 플러그인 캐시 초기화) 후에도
# 유지된다(자가 복구). 저장소는 .claude-plugin/marketplace.json이 있는 Claude
# 마켓플레이스 저장소여야 한다. 플러그인/저장소 하나의 실패(또는 타임아웃)는
# 로그만 남기고 건너뛰며 게이트웨이 시작을 절대 막지 않는다.
#
# repo가 이미 존재하는 로컬 경로(예: bind mount)를 가리키면 그 자리에서 그대로
# 사용하고 clone하지 않으므로, 시작마다 새로 clone하는 동작은 원격 URL에만
# 적용된다.
#
# 참고: 설치된 플러그인은 영속 claude_home 볼륨의
# ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/ 아래에 놓인다.
# 플러그인이 업데이트되면서 옛 버전 디렉터리가 쌓이므로, 공간 회수가 필요하면
# 주기적으로 `docker compose down -v`(또는 볼륨 정리)를 실행한다.
#
# (2026-07 제거) env 부트스트랩(CLAUDE_PLUGIN_REPO* 레거시/인덱스 형식)은
# 삭제되었다. 해당 변수를 설정해도 무시된다 — 플러그인 선언은 admin 패널이
# 유일한 경로다.
#
# manifest 경로 (Docker에서는 compose가 ./data bind mount의 기본값으로 고정):
# CLAUDE_PLUGIN_MANIFEST=/app/data/gateway-plugins.json
#
# private HTTPS 마켓플레이스 저장소는 토큰을 설정한다. admin 패널은 git 토큰을
# manifest에 절대 기록하지 않으므로, admin으로 추가한 PRIVATE 마켓플레이스는
# 시작 시 재생(clone)할 때 이 토큰을 자격증명으로 상속한다. 설치기는 토큰을
# URL에 박아 넣는 대신 임시 askpass 헬퍼로 git에 전달하며, claude CLI에는 절대
# 전달하지 않는다. public 마켓플레이스는 토큰이 필요 없다.
# CLAUDE_PLUGIN_GIT_TOKEN=your-personal-access-token
#
# CLAUDE_PLUGIN_CLAUDE_BIN=          # 선택; 기본은 PATH 또는 SDK 번들 claude
# CLAUDE_PLUGIN_CLONE_ROOT=          # 선택; clone 루트 (기본 ~/.claude/plugin-marketplaces)
# CLAUDE_PLUGIN_TIMEOUT_SECONDS=300  # 선택; git/claude 호출별 타임아웃 (기본 300)
#
# 마켓플레이스 자동 갱신(컨테이너 재시작 사이에, 게이트웨이가 관리하는 모든
# 마켓플레이스를 주기적으로 재-clone + `claude plugin update`)은 env 변수가
# 아니라 관리자 대시보드의 Plugins 탭에서 설정한다. 토글 + 주기는 manifest의
# auto_refresh 레코드에 영속되며 재시작 없이 적용된다.
#
# Claude SDK setting sources. Docker가 아닌 런타임의 기본값은 project,local.
# Docker Compose는 컨테이너 시작 시 설치된 user-scope 플러그인이 Claude에
# 보이도록 기본값을 user,project,local로 둔다.
# CLAUDE_SETTING_SOURCES=user,project,local
#
# 세션이 띄우는 Claude CLI 바이너리 오버라이드. 미설정이면 SDK 번들 CLI를
# 쓴다 (claude-agent-sdk==0.2.128 번들은 CLI 2.1.220 — MCP 프로토콜은
# 2025-11-25까지 협상). 2026-07-28 stateless 개정(MCP 2.0)을 쓰는 MCP 서버를
# 붙이려면 CLI 2.1.221+ 경로를 지정한다. 실행 파일이 아니면 경고 후 무시하고
# 번들 CLI로 동작한다 (fail-safe).
# CLAUDE_CLI_PATH=/usr/local/bin/claude
#
# git/curl/Python이 호스트와 같은 신뢰 루트를 쓰도록 호스트 CA 번들을 컨테이너의
# Debian CA 경로에 마운트한다. 기본값은 Ubuntu/Debian 기준.
HOST_CA_CERTIFICATES_PATH=/etc/ssl/certs/ca-certificates.crt

# 시작 시 권한 복구 후 사용하는 Docker 런타임 uid/gid. 기본값은 일반적인 Linux
# 개발자 사용자와 일치한다. 호스트의 bind-mount된 ./data 디렉터리 소유자가 다른
# uid/gid라면 `id -u` / `id -g` 값으로 설정한다.
# APP_UID=1000
# APP_GID=1000

# 서버 설정
PORT=8000
# 호스트 바인딩 주소 — 로컬 전용 접근은 127.0.0.1, 모든 인터페이스는 0.0.0.0
# GATEWAY_HOST=0.0.0.0
#
# 레거시: GATEWAY_HOST 미설정 시 CLAUDE_WRAPPER_HOST도 계속 인정된다.
# 최대 요청 본문 크기(바이트) (기본: 10MB)
# MAX_REQUEST_SIZE=10485760

# 타임아웃 설정 (밀리초)
MAX_TIMEOUT=600000

# 백그라운드(background: true) 턴 하나의 wall-clock 상한(초).
# 백그라운드 턴은 상한 역할을 해 줄 HTTP 연결이 없으므로, 이 값이 멈춘 백엔드가
# 세션 락을 영원히 잡고 있는 것을 막는다. 기본: 3600.
# BACKGROUND_RESPONSE_TIMEOUT_S=3600

# CORS 설정
CORS_ORIGINS=["*"]

# 모델 설정
# 요청에 모델이 지정되지 않았을 때 사용할 기본 Claude 모델
DEFAULT_MODEL=sonnet

# 백엔드 설정
# 유지보수되는 백엔드는 Claude뿐이다. stale 상태인 OpenCode/Codex 백엔드
# (2026-07 동결, 유지보수 없음)는 의도적으로 여기서 더 이상 문서화하지 않는다.
# BACKENDS로 활성화하면 시작 시 경고가 로그에 남고 언제든 깨질 수 있다.
# BACKENDS=claude

# 이미지 입력에 대한 텍스트 전용 모델 denylist (vision 능력 게이팅).
# LiteLLM(또는 어떤 프록시든)이 하나의 Anthropic 엔드포인트를 여러 모델로
# 라우팅할 때, vision이 없는 모델로 보낸 이미지 입력은 업스트림에서 뒤늦게
# 실패하거나 조용히 버려진다. 텍스트 전용 모델을 여기 나열하면 그 모델로 가는
# 이미지 입력을 400으로 선제 거절한다. 쉼표 구분, fnmatch 글롭, 대소문자 무시;
# 먼저 해석된 provider_model에, 그다음 public 모델에 매칭한다.
# 비어 있으면(기본) 어떤 모델도 게이팅하지 않는다.
# TEXT_ONLY_MODELS=o1-mini,deepseek-*,gpt-4o-mini-tts

# SDK 설정
# 요청당 최대 대화 턴 수
# DEFAULT_MAX_TURNS=10

# 요청이 permission_mode를 생략했을 때 적용되는 서버 기본 권한 모드.
# 요청 본문의 permission_mode가 이 값을 재정의한다. 유효한 값:
#   default, acceptEdits, bypassPermissions, plan
# 미설정 = None을 그대로 전달(백엔드 기본값). 참고: 도구 차단은 이 모드가 아니라
# DISALLOWED_TOOLS로 강제한다.
# PERMISSION_MODE=default

# ============================================================================
# 시스템 프롬프트 설정
# ============================================================================
# 커스텀 시스템 프롬프트가 담긴 텍스트 파일(.txt/.md) 경로.
# 설정하면 claude_code 프리셋을 완전히 대체한다.
# /admin UI에서 런타임에 설정할 수도 있다.
#
# DOCKER: 여기 적은 호스트 경로는 컨테이너 안에서 보이지 않는다. 대신 아래
# SYSTEM_PROMPT_HOST_FILE에 호스트 파일을 지정하면 docker-compose가 읽기 전용으로
# 마운트하고 SYSTEM_PROMPT_FILE을 자동으로 그쪽으로 가리켜 준다. (compose
# environment 블록이 SYSTEM_PROMPT_FILE을 재정의하므로 Docker에서는 여기 설정해도
# 효과가 없다.)
#   SYSTEM_PROMPT_HOST_FILE=/home/me/my-system-prompt.md
#
# DOCKER가 아닐 때(게이트웨이 직접 실행): 여기에 경로를 설정한다.
# SYSTEM_PROMPT_FILE=docs/claude-code-system-prompt-reference.md

# 시스템 프롬프트의 {{PLACEHOLDER}} 토큰에 치환되는 값들.
# 프롬프트 파일을 로드할 때 치환된다.
# PROMPT_LANGUAGE=Korean
#
# 자동 감지 placeholder (env 변수 불필요):
#   {{WORKING_DIRECTORY}} ← 요청별 워크스페이스 cwd
#   {{MEMORY_PATH}}       ← <cwd>/.memory (요청마다 자동 생성)
#   {{PLATFORM}}          ← sys.platform (자동)
#   {{SHELL}}             ← $SHELL (자동)
#   {{OS_VERSION}}        ← platform.platform() (자동)

# Thinking 모드: adaptive (기본, 권장), enabled (고정 budget), disabled
# 요청 단위 override: /v1/responses의 reasoning.effort, /v1/agents/messages의
# effort (none|low|medium|high|xhigh|max) — 지정 시 이 전역 설정보다 우선.
# THINKING_MODE=adaptive
# "enabled" 모드의 budget 토큰 수 (adaptive/disabled에서는 무시)
# THINKING_BUDGET_TOKENS=10000

# 태스크 budget(토큰) — 모든 요청에 적용되는 전역 기본값.
# 모델이 이 한도를 넘지 않도록 도구 사용 속도를 조절하고 마무리한다.
# API 본문의 요청별 task_budget이 이 값을 재정의한다.
# TASK_BUDGET=

# 토큰 단위 스트리밍 (true=토큰을 개별 스트리밍, false=완성된 메시지 단위로 대기)
# TOKEN_STREAMING=true

# 차단할 서브에이전트 타입 (쉼표 구분)
# Agent(type) 문법으로 특정 내장 서브에이전트 타입을 차단한다.
# 사용 가능한 타입: general-purpose, Explore, Plan, statusline-setup
# DISALLOWED_SUBAGENT_TYPES=statusline-setup

# 차단할 도구 (쉼표 구분)
# 요청의 allowed_tools나 permission_mode와 무관하게 특정 Claude SDK 도구를
# 차단한다. 게이트웨이가 bypassPermissions 모드로 동작하는데, 이 모드에서
# allowed_tools는 자동 승인 힌트일 뿐 도구 사용을 엄격히 제한하지 않기 때문에
# 필요하다. 기본은 미설정(추가 차단 없음).
# 일반 도구를 deny하면 모델의 도구 표면에서 완전히 제거된다 — skill과 달리
# 목록에서 사라진다. 일반 도구(WebFetch, WebSearch)와 하네스/오케스트레이션
# 도구(ScheduleWakeup, ShareOnboardingGuide, CronCreate/CronDelete/CronList,
# DesignSync, NotebookEdit, RemoteTrigger, ...) 모두에 적용된다.
# skill은 도구 이름이 아니다: skill 하나는 Skill(<name>)으로, 모든 skill은
# Skill로 차단한다. skill 이름만 적으면(예: deep-research) 아무것도 매칭되지
# 않는다(no-op).
# DISALLOWED_TOOLS=WebFetch,WebSearch,Skill(deep-research)
# DISALLOWED_TOOLS=WebFetch,WebSearch,ScheduleWakeup,ShareOnboardingGuide,CronCreate,CronDelete,CronList,DesignSync,NotebookEdit,RemoteTrigger,Skill(deep-research)

# 차단할 슬래시 커맨드 (쉼표 구분, 앞 슬래시는 선택)
# 클라이언트가 입력한 슬래시 커맨드를 400 blocked_command로 거절하며, 항상
# 차단되는 파괴적 내장 커맨드(/compact, /init, /heapdump)와 합쳐진다.
# DISALLOWED_TOOLS의 Skill(<name>)은 모델이 시작하는 경로를 막고, 이 설정은
# 클라이언트가 입력하는 /name 경로를 막는다 — skill을 완전히 끄려면 둘 다
# 설정한다.
# BLOCKED_SLASH_COMMANDS=deep-research,verify,code-review,run,security-review

# 숨길 skill (쉼표 구분, 앞 슬래시는 선택)
# 모델의 카탈로그에서 skill을 제거한다: 게이트웨이가 SDK의 ``skills`` 옵션을
# "발견된 커맨드 − 이 목록" 형태의 allowlist로 변환하므로, 목록에서 빠진 skill은
# 시스템 프롬프트에서 사라지고 Skill 도구 디스패치에서 거절된다. 차단만으로는
# (Skill(<name>) deny) 실행은 막아도 모델에게 skill이 계속 보인다 — skill을
# 완전히 끄려면 셋 다 설정한다: HIDDEN_SKILLS(카탈로그), DISALLOWED_TOOLS의
# Skill(<name>)(실행 백스톱), BLOCKED_SLASH_COMMANDS(클라이언트 입력 /name).
# HIDDEN_SKILLS=deep-research,verify,code-review,run,security-review

# 서브에이전트 스트리밍 가시성
# 스트리밍 중 어떤 서브에이전트 출력을 클라이언트로 전달할지 제어한다.
# SUBAGENT_STREAM_TEXT: 서브에이전트 텍스트 delta 전달 (기본: false — 최종 요약만)
# SUBAGENT_STREAM_TOOL_BLOCKS: 서브에이전트 tool_use/tool_result 블록 전달 (기본: true)
# SUBAGENT_STREAM_PROGRESS: task_started/progress/notification 이벤트 전달 (기본: true)
# SUBAGENT_STREAM_TEXT=false
# SUBAGENT_STREAM_TOOL_BLOCKS=true
# SUBAGENT_STREAM_PROGRESS=true

# 실험적: 에이전트 팀 (멀티 에이전트 teammate)
# 모델이 협업하는 teammate를 만들 수 있는 Claude CLI의 실험적 agent-team 모드를
# 켠다 (TeamCreate/TeamDelete/SendMessage 도구 + 공유 태스크 목록). 기본은
# OFF이며 도구 카탈로그에도 노출되지 않는다. 여기(프로세스 env) export가 시작
# 기본값이고, admin 패널 Config 탭의 "Agent Teams" 런타임 토글이 새 세션에
# 한해 이 값을 덮어쓴다 (토글은 게이트웨이 재시작 시 초기화).
# 계정에 서버 측(statsig) feature gate가 필요할 수도 있어 env 변수만으로는
# 충분하지 않을 수 있다. 활성화되면 teammate 활동은 위의 SUBAGENT_STREAM_*
# 채널(task_started/progress/updated)로 드러나고, 팀 도구는 다른 도구처럼 자동
# 승인된다.
# teammate가 리더 세션에 보낸 메시지는 /v1/responses 스트리밍에서
# response.teammate_message 이벤트로 전달된다.
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Liveness / "작업 중" 진행 신호 (Responses API 스트리밍)
# 텍스트 사이의 공백 구간 — 긴 tool-call 인자 생성, hook 실행, 컨텍스트 압축 —
# 에도 UI가 활동을 표시할 수 있도록 추가 이벤트를 전달한다.
# STREAM_TOOL_PROGRESS: 도구 호출 시작 시, 인자 스트리밍이 끝나기 전에
#   response.tool_use_started를 발행한다 (기본: true).
# STREAM_HOOK_EVENTS: SDK의 include_hook_events를 켜고 hook 라이프사이클
#   (PreToolUse/PostToolUse/Stop/…)을 response.hook_event로 전달한다 (기본: true).
# STREAM_COMPACTION_EVENTS: 컨텍스트 압축(compact_boundary)을
#   response.compaction으로 전달한다 (기본: true).
# STREAM_TOOL_PROGRESS=true
# STREAM_HOOK_EVENTS=true
# STREAM_COMPACTION_EVENTS=true

# Bash 샌드박스 (Bash 도구 실행의 OS 수준 프로세스 격리)
# 3상태: 미설정 = 프로젝트 수준 설정 존중, true = 강제 켜기, false = 강제 끄기
# Bash 명령에만 영향을 준다. Read/Edit/Write 접근은 SDK 권한 규칙이 제어한다.
# macOS(Seatbelt) 또는 Linux(bubblewrap)가 필요하다. Windows는 미지원.
# CLAUDE_SANDBOX_ENABLED=true
# 샌드박스 상태에서는 bash 명령을 자동 승인 (기본: true)
# CLAUDE_SANDBOX_AUTO_ALLOW_BASH=true
# 샌드박스를 우회하는 명령 목록 (쉼표 구분, 기본: 없음)
# CLAUDE_SANDBOX_EXCLUDED_COMMANDS=
# 모델이 dangerouslyDisableSandbox로 비샌드박스 실행을 요청하도록 허용 (기본: false)
# CLAUDE_SANDBOX_ALLOW_UNSANDBOXED=false
# 샌드박스 안에서 로컬 네트워크 포트 바인딩 허용 (기본: false)
# CLAUDE_SANDBOX_NETWORK_ALLOW_LOCAL=false
# Linux의 비특권 Docker 컨테이너용 약화된 샌드박스 사용 (기본: false)
# CLAUDE_SANDBOX_WEAKER_NESTED=false

# 워크스페이스별 샌드박스 (파일/Bash 경로를 세션 워크스페이스 루트로 제한하는
# PreToolUse hook). cwd/acceptEdits가 강제하지 못하는, 공유 워크스페이스 루트
# 아래에서의 사용자 간 접근을 방어한다. 기본: 비활성화.
# 이걸 켜고 CLAUDE_SANDBOX_ENABLED가 미설정이면, hook이 정적으로 해석할 수 없는
# 런타임 셸 확장($VAR, 명령 치환)에 대한 심층 방어 백스톱으로 위의 OS 수준 bash
# 샌드박스가 강제 활성화된다.
# WORKSPACE_SANDBOX_ENABLED=true
# 워크스페이스 바깥 경로 접근이 허용되는 카테고리 (쉼표 구분:
# read / write / bash). 비어 있음 = 전부 제한. 기본: 비어 있음.
# WORKSPACE_SANDBOX_ALLOW_OUTSIDE=

# SSE keepalive 간격(초) — 긴 SDK 작업 중 연결이 끊기는 것을 방지한다.
# 0이면 비활성화. 기본: 15
# SSE_KEEPALIVE_INTERVAL=15

# 세션 관리
# SESSION_CLEANUP_INTERVAL_MINUTES=5
# SESSION_MAX_AGE_MINUTES=60

# ---------------------------------------------------------------------------
# 동시성 admission control
# ---------------------------------------------------------------------------
# 라이브 세션 각각은 턴이 실행 중일 때만이 아니라 TTL 전체 동안(위
# SESSION_MAX_AGE_MINUTES 참고) Claude CLI 서브프로세스를 하나씩 붙잡는다.
# 측정상 서브프로세스 하나가 ~400 MB RSS를 차지하므로, MCP 자식 프로세스
# 여유분을 포함해 라이브 세션당 ~0.5 GB로 예산을 잡는다.
#
# 실제로 OOM을 막는 설정은 MAX_LIVE_SESSIONS다: 유휴 세션도 서브프로세스를
# 계속 잡고 있으므로 in-flight 턴만 제한해서는 아무 소용이 없다. 대략적인 사이징:
#
#     4 GB 호스트  ->  6      8 GB 호스트  -> 12      16 GB 호스트 -> 24
#
# 기본값(12)은 8 GB 호스트 기준이다. 감지된 cgroup/호스트 메모리가 감당할 수
# 없는 값이면 게이트웨이가 시작 시 경고를 로그로 남긴다.
# 여기서 거절된 호출자는 Retry-After와 함께 503을 받고, 이미 성립한 대화
# (previous_response_id)는 절대 거절되지 않는다.
# MAX_LIVE_SESSIONS=12

# 동시에 실행할 수 있는 에이전트 턴 수. 메모리가 아니라 CPU와 업스트림 API
# 부하를 제한한다. 거절은 fail-fast 503 + Retry-After다 — 턴은 MAX_TIMEOUT
# (기본 10분)까지 돌 수 있어서, 대기자를 큐에 세우면 어떤 클라이언트도 견디지
# 못할 만큼 연결을 오래 붙잡게 된다.
# MAX_CONCURRENT_TURNS=8

# 요청의 "user" 필드를 키로 하는 호출자별 상한.
#
# 공정성 힌트이지 보안 컨트롤이 아니다. "user"는 호출자가 제공하며 어떤
# 자격증명과도 묶이지 않는다: 값을 바꿔 가며 보내면 이 제한을 완전히 회피할 수
# 있고, 다른 호출자의 값을 사칭하면 그쪽 몫을 태운다. 선량한 클라이언트끼리
# 서로 굶기지 않게 하는 용도이며, 악의적 호출자에 대해서는
# MAX_CONCURRENT_TURNS만이 실질적인 방어선이다.
#
# 실제로 "user"를 담아 보낸 요청에만 적용된다. 식별되지 않은 호출자("user" 필드
# 없음, content-length 없는 chunked 업로드, 그리고 스키마가 이 필드를 금지하는
# /v1/agents/messages 전체)는 버킷 하나를 공유하므로, 거기에 적용하면
# 엔드포인트 전체가 이 숫자로 캡되어 버린다. 이들은 대신 MAX_CONCURRENT_TURNS로
# 제한된다.
# MAX_CONCURRENT_TURNS_PER_USER=3

# 셋 중 어느 것이든 0으로 설정하면 그 제한이 완전히 꺼진다.

# AskUserQuestion hook 타임아웃(초).
# 이 시간 안에 클라이언트가 응답하지 않으면 hook이 도구 호출을 deny하고 SDK가
# 재개된다. 기본: 300 (5분).
# ASK_USER_TIMEOUT_SECONDS=300

# MCP 서버 설정
# MCP 설정 JSON 파일 경로 또는 인라인 JSON 문자열
# 형식: {"mcpServers": {"name": {"type": "stdio|sse|http|streamable-http", ...}}}
# MCP_CONFIG={"mcpServers": {"filesystem": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"]}}}
# MCP_CONFIG=/path/to/mcp-config.json
#
# 서버별 env(stdio)와 headers(http/sse/streamable-http)는 그 MCP 설정에만
# 저장되며 게이트웨이 프로세스 환경에는 절대 병합되지 않는다. 값에는
# {{env:NAME}}으로 게이트웨이 env 변수를 참조할 수 있고, (admin 저장 시점이
# 아니라) Claude 세션 생성 시점에 해석된다:
#   "env": {"GITHUB_TOKEN": "{{env:GITHUB_TOKEN}}"}
#   "headers": {"Authorization": "Bearer {{env:MCP_TOKEN}}"}
#
# 관리자 관리 MCP 서버 manifest (./data bind mount의 data/gateway-mcp.json).
# MCP_CONFIG가 base/기본값으로 유지되고 이 manifest가 그 위에 겹쳐진다
# (이름 충돌 시 manifest 우선). 관리자 패널 CRUD가 여기에 기록하며 변경은
# NEW 세션에 HOT-RELOAD된다.
# GATEWAY_MCP_MANIFEST=/app/data/gateway-mcp.json
#
# *플러그인 제공* MCP 서버에 대한 관리자 관리 자격증명 오버레이 (env/headers만;
# 플러그인의 command/url은 플러그인에 남는다). NEW Claude 세션으로
# hot-reload된다. 병합된 설정이 플러그인 자체의 서버 등록을 대체하며(고정된
# SDK의 CLI에서 검증), 오버레이 값은 MCP 서버 프로세스로 범위가 한정된다 —
# 세션 프로세스 환경에는 주입되지 않는다. 플러그인이 더 이상 설치되어 있지 않은
# 오버레이는 통째로 건너뛴다. 경로 재정의:
# GATEWAY_MCP_PLUGIN_OVERLAY=/app/data/gateway-mcp-plugin-overlay.json
#
# 같은 자격증명 오버레이의 배포 시점 버전, MCP 서버 이름을 키로 쓴다:
# 이름 하나의 서버에 대한 env/headers를 관리자 패널에서 클릭하는 대신 여기서
# 선언한다. 인라인 JSON 또는 JSON 파일 경로(MCP_CONFIG와 같은 이중 형식)라서
# docker/K8s secret을 마운트해 가리킬 수 있다.
#   {"<server>": {"env": {...}, "headers": {...}}}
# 값에는 다른 MCP env/header처럼 {{env:NAME}}을 쓸 수 있어, 실제 secret을 이
# JSON이 아니라 평범한 게이트웨이 env 변수에 둘 수 있다.
# 서버 이름별 해석은 Claude 세션 생성 시점에 일어난다: 그 이름을 선언한 설치된
# 플러그인이 우선하고(오버레이가 플러그인의 command/url 위에 병합), 아니면 그
# 이름의 게이트웨이 MCP_CONFIG/manifest 서버가 병합을 받는다; 어느 쪽도
# 선언하지 않은 이름은 경고 로그 후 건너뛴다. 키 단위로는 admin 오버레이 파일이
# 우선하므로, 이 값은 운영자가 패널에서 hot-fix할 수 있는 기본값이다. 값은 MCP
# 서버 프로세스로 범위가 한정되며 — 세션 프로세스 환경에는 절대 주입되지 않는다.
# 시작 시와 admin 오버레이 저장/삭제 시마다 읽히므로, 파일 기반 레이어는 자체
# 갱신되지 않고 다음 그런 reload(또는 게이트웨이 재시작) 때 수정 사항을
# 반영한다. Claude 백엔드 전용.
# GATEWAY_MCP_SERVER_ENV={"context7":{"env":{"CONTEXT7_API_KEY":"{{env:CONTEXT7_API_KEY}}"}}}
# GATEWAY_MCP_SERVER_ENV=/run/secrets/mcp-server-env.json

# Claude 세션 프로세스용 env 변수 — ~/.claude/settings.json에서 관리된다.
# 위 GATEWAY_MCP_SERVER_ENV와는 적용 범위가 다르다: Claude Code는 settings의
# "env" 블록을 세션 프로세스에 적용하므로 에이전트 자신의 Bash가 이 값들을 읽을
# 수 있고, 상속된 프로세스 환경의 같은 키를 덮어쓴다(라이브 검증, CLI 2.1.220).
# 따라서 게이트웨이 인증 키(ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL,
# Bedrock/Vertex 스위치)는 거절된다.
# 배포 시점 기본값을 여기 인라인 JSON 또는 JSON 파일 경로로 선언한다
# ({"NAME": "value"} 또는 {"env": {...}}); 관리자 패널의 Claude 세션 env 카드가
# 키 단위로 그 위에 겹쳐지고, 둘 다 시작 시와 저장할 때마다 settings 파일로
# 투영된다. 다른 settings 키(permissions/hooks/...)와 게이트웨이가 쓴 적 없는
# env 키는 보존된다. {{env:NAME}}은 투영 시점에 해석되므로 원본 변수를 교체하면
# 재투영이 필요하다(관리자 카드에 버튼이 있음).
# CLAUDE_SETTING_SOURCES에 'user'가 포함되어야 한다(docker-compose 기본값은
# 포함).
# GATEWAY_CLAUDE_SETTINGS_ENV={"CORP_PROXY":"http://proxy.internal:3128","TEAM_ID":"platform"}
# GATEWAY_CLAUDE_SETTINGS_ENV=/run/secrets/claude-session-env.json
#
# 관리 파일과 admin 저장소의 위치 (기본값 표시):
# GATEWAY_CLAUDE_SETTINGS_PATH=/home/app/.claude/settings.json
# GATEWAY_CLAUDE_SETTINGS_ENV_STORE=/app/data/gateway-claude-settings-env.json

# 메타데이터 env 변수 passthrough (쉼표 구분 allowlist)
# 여기 나열된 메타데이터 키만 Claude 서브프로세스에 env 변수로 전달된다.
# 호출자는 /v1/responses 요청의 "metadata" 필드로 이 값들을 보낸다.
# 예: a2a-agent는 매 턴 metadata={"THREAD_ID": "abc"}를 보낸다.
METADATA_ENV_ALLOWLIST=THREAD_ID,ORCHESTRATOR_URL

# 디버깅
# DEBUG_MODE=false
# VERBOSE=false

# 시작 시 설정 검증의 탈출구. 서버는 모순된 설정에서 fail-fast한다
# (src/config_check.py 참고). true로 설정하면 문제를 경고로만 로그하고 그대로
# 시작한다 — 지적된 설정을 감수하기로 한 운영자용. 기본: false.
# SKIP_CONFIG_CHECK=false

# ============================================================================
# 관리자 UI 설정
# ============================================================================
# 워크스페이스 파일 관리, 설정 조회, 세션 모니터링, 백엔드 상태 확인을 위한
# /admin 웹 대시보드.

# 관리자 API 키 (필수 — 없으면 서버가 시작하지 않는다)
# 게이트웨이 API_KEY와는 별개다 — admin은 더 높은 권한의 표면이다.
# ADMIN_API_KEY=your-secure-admin-key-here

# 관리자 세션 TTL(초) (기본: 3600 = 1시간)
# ADMIN_SESSION_TTL=3600

# 관리자 세션 쿠키는 기본으로 Secure(HTTPS 전용)로 표시된다.
# 로컬 HTTP 개발에서 plain HTTP로 쿠키를 허용하려면 false로 설정한다.
# ADMIN_COOKIE_SECURE=true

# Rate Limiting 설정
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_DEBUG_PER_MINUTE=2
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=5
RATE_LIMIT_SESSION_PER_MINUTE=15
RATE_LIMIT_HEALTH_PER_MINUTE=30
RATE_LIMIT_RESPONSES_PER_MINUTE=10

# ============================================================================
# Docker Build-Time Options (`docker compose build`가 소비 — 런타임 아님)
# ============================================================================
# 이 값들은 런타임에 서버가 읽지 않는다. docker-compose.yml이 build.args를 통해
# 빌드 시점에 가져간다. 공용 네트워크에서는 비워 둔다.

# 게이트웨이 이미지 안의 시스템 패키지에 사용할 Debian apt 미러.
# Dockerfile이 python:3.12-slim-trixie를 고정하므로 미러는 trixie,
# trixie-updates, trixie-security를 제공해야 한다.
# APT_MIRROR_URL=http://apt-mirror.example.com/debian

# 선택적 별도 Debian security 미러. 미설정 시 security 소스에도 APT_MIRROR_URL이
# 사용된다.
# APT_SECURITY_MIRROR_URL=http://apt-mirror.example.com/debian-security

# 사설 PyPI 미러 (예: 사내 Nexus). 설정하면 pip이 pypi.org 대신 이 인덱스에서
# 패키지를 받는다.
# PIP_INDEX_URL=https://nexus.example.com/repository/pypi/simple/

# PIP_INDEX_URL 다음 순서로 검색되는 추가 pip 인덱스.
# PIP_EXTRA_INDEX_URL=https://extra-index.example.com/simple/

# pip 미러가 plain HTTP로 제공될 때 필수 — 아니면 pip이 HTTP 인덱스를 조용히
# 무시한다. 스킴/경로 없는 호스트명만 적는다. 여러 호스트는 공백으로 구분.
# PIP_TRUSTED_HOST=nexus.example.com

# Docker 이미지 빌드 중 root로 실행되는 선택적 로컬 install 스크립트.
# 파일은 BuildKit secret으로 마운트되며 이미지나 저장소에 복사되지 않는다.
# 비워 두면 내장 no-op 훅이 실행된다.
# GATEWAY_BUILD_INSTALL_SCRIPT=/opt/company/install_gateway_addons.sh
# 스크립트를 바꾼 뒤에는 이 값을 올리거나 --no-cache로 빌드한다.
# GATEWAY_BUILD_INSTALL_CACHE_BUST=2026-05-25

# 빌드용 HTTP(S) 프록시 (apt-get, npm, pip, 이미지 pull).
# Docker가 미리 정의된 proxy ARG로 취급한다 — 이미지 히스토리에 남지 않는다.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.example.com

# ---------------------------------------------------------------------------
# 사용량 로깅 (선택)
# ---------------------------------------------------------------------------
# USAGE_LOG_DB_URL을 설정하면 게이트웨이가 /v1/responses 턴마다 한 행씩 설정된
# 데이터베이스에 기록한다 (바로 쓸 수 있는 MySQL 사이드카는 docker-compose의
# `logging` 프로필 참고). 타임스탬프는 UTC로 저장되고, admin 사용량 화면의 날짜
# 필터, 버킷, 표시되는 턴 시각은 KST를 쓴다. 비워 두면 비활성화.
# 기존 행이 있는 데이터베이스를 업그레이드하기 전에는 이전 런타임이 UTC
# 타임스탬프를 기록했는지 확인한다; 레거시 프로세스-로컬 타임스탬프는 자동으로
# 감지할 수 없다.
#
# URL은 SQLAlchemy URL이다. 아래 축약형은 async 드라이버로 자동 매핑된다
# (드라이버는 설치되어 있어야 한다):
#   mysql://...       -> mysql+aiomysql://...      (aiomysql, 기본 포함)
#   sqlite://...      -> sqlite+aiosqlite://...    (aiosqlite 설치 필요)
# USAGE_LOG_DB_URL=mysql://gateway:gateway@gateway-log:3306/gateway_log
# USAGE_LOG_DB_URL=sqlite+aiosqlite:///./data/gateway_log.sqlite

# docker-compose.yml의 `gateway-log` MySQL 사이드카가 쓰는 자격증명.
# 프로덕션 배포에서는 반드시 재정의한다.
# GATEWAY_LOG_MYSQL_ROOT_PASSWORD=gateway_root
# GATEWAY_LOG_MYSQL_USER=gateway
# GATEWAY_LOG_MYSQL_PASSWORD=gateway
# GATEWAY_LOG_MYSQL_DATABASE=gateway_log
# GATEWAY_LOG_PORT=3306
#
# `gateway-log` MySQL 사이드카는 `logging` compose 프로필 뒤에 있어서 그
# 프로필이 활성일 때만 시작한다. CLI 플래그(`docker compose --profile logging
# up -d`)로 켜거나, 이 Compose 내장 변수를 여기에 설정해 평범한
# `docker compose up -d`에도 포함되게 한다. Docker Compose가 파싱 시점에만
# 읽으며 애플리케이션 자체는 사용하지 않는다.
# COMPOSE_PROFILES=logging
