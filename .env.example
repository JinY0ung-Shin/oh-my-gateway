# Authentication Method (optional - explicit selection)
# Set this to override auto-detection. Values: cli, api_key
# If not set, auto-detects based on available env vars (ANTHROPIC_AUTH_TOKEN, etc.)
# CLAUDE_AUTH_METHOD=cli

# Claude Code Environment Variables
# These are passed through to the Claude Code CLI / Agent SDK
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=your-auth-token
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-5-20250929
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
# When set, each configured name is ALSO advertised in /v1/models (alongside the
# bare opus/sonnet/haiku aliases) and can be requested as a model id; the gateway
# maps it back to the bare alias so the CLI performs the real alias resolution.

# Optional Anthropic Messages stream sanitizer.
# Keep ANTHROPIC_BASE_URL pointed at the real Anthropic-compatible upstream
# (for example LiteLLM in Docker Compose: http://litellm:4000). When enabled,
# the gateway rewrites only the Claude SDK subprocess env so Claude calls the
# local sanitizer route first, and the sanitizer forwards to ANTHROPIC_BASE_URL.
# If ANTHROPIC_BASE_URL is unset, enabling the sanitizer has no effect.
# SANITIZER_ENABLED=false
# SANITIZER_REQUEST_TIMEOUT=0
# TLS verification for the upstream call. Default is on (verifies with system CAs).
# Set to "false" to disable (INSECURE — only for trusted networks where the
# upstream uses a private/self-signed cert and you accept MITM risk), or set to
# a file path to use a custom CA bundle (recommended over disabling).
# SANITIZER_TLS_VERIFY=true
#
# Translate Anthropic <-> OpenAI in-process instead of relying on the upstream's
# own Anthropic adapter. When enabled, the sanitizer route forwards to
# {ANTHROPIC_BASE_URL}/v1/chat/completions and rewrites both directions itself.
# Use when the upstream's Anthropic adapter mis-serializes tool calls or
# reasoning content (e.g. some LiteLLM setups). Default: false.
# SANITIZER_USE_OPENAI_BRIDGE=false


# API Configuration
# If API_KEY is not set, server will prompt for interactive API key protection on startup
# Leave commented out to enable interactive prompt, or uncomment to use a fixed API key
# API_KEY=your-optional-api-key-here

# Per-user workspace isolation
# Base directory for user workspaces ({dir}/{user}/{backend}/ per user+backend).
# If unset, the gateway uses a per-host temp base (<tmp>/oh-my-gateway-workspaces):
# anonymous requests get a per-session subdir cleaned on expiry. Workspaces start
# empty; Claude config is loaded from ~/.claude (and ~/.claude/plugins)
# independently of the workspace.
#
# In Docker: docker-compose.yml bind-mounts ./workspaces (host) to
# /data/workspaces (container) and the compose environment block defaults
# USER_WORKSPACES_DIR to /data/workspaces, so per-user state is persisted to the
# host out of the box. (Because the compose default always applies, leaving this
# unset in .env still resolves to /data/workspaces under Docker — to change it,
# edit the value here or the compose environment block.)
# USER_WORKSPACES_DIR=/data/workspaces

# Host-side path for the per-user workspaces bind mount (Docker only).
# Defaults to ./workspaces next to docker-compose.yml. Override to put the
# workspaces tree somewhere else on the host (e.g. /srv/gateway/workspaces).
# Read at compose parse-time only; not used by the application itself.
# USER_WORKSPACES_HOST_DIR=./workspaces

# ---------------------------------------------------------------------------
# Start-time setup hook (optional)
# ---------------------------------------------------------------------------
# Absolute path to a script run on every container start (as the unprivileged
# app user, fail-fast) before plugin install + the server. Use it for
# private/corporate setup such as writing ~/.claude/settings.json, so an overlay
# image can add setup without rewriting the container CMD. The script must be
# present in the image (bind mount or the build-time install hook). Unset = skip.
# GATEWAY_STARTUP_SCRIPT=/usr/local/bin/setup_claude_settings.py

# ---------------------------------------------------------------------------
# Marketplace plugin auto-install (optional)
# ---------------------------------------------------------------------------
# On every container start the gateway removes any previous clone and re-runs
# `git clone --depth 1 --branch <branch>` for each configured marketplace URL
# (branch defaults to main; override per repo with CLAUDE_PLUGIN_BRANCH*), then
# `claude plugin marketplace add`, then `claude plugin install` +
# `claude plugin update` for each plugin so the LATEST version is always
# installed. The repo must be a Claude marketplace repo with
# .claude-plugin/marketplace.json. Leave all CLAUDE_PLUGIN_REPO* vars unset to
# disable. A failure (or timeout) for one plugin or repo is logged and skipped —
# it never blocks the gateway from starting.
#
# A CLAUDE_PLUGIN_REPO that points at an existing local path (e.g. a bind mount)
# is used in place and is NOT cloned, so the fresh-clone-on-every-start behavior
# applies to remote URLs only.
#
# The clone uses `--branch main` by default. If a marketplace repo's default
# branch is not `main` (e.g. `master`), set CLAUDE_PLUGIN_BRANCH* for that repo
# or the clone fails (logged + skipped; never blocks startup).
#
# Note: installed plugins live in the persistent claude_home volume under
# ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/. As plugins are
# updated over time, older version dirs accumulate; run `docker compose down -v`
# (or prune the volume) periodically to reclaim space.
#
# Multiple repos / multiple plugins per repo — use the indexed form (_1, _2, …).
# CLAUDE_PLUGIN_NAME_N is a comma-separated list of plugins to install from
# that repo (defaults to the repo basename when omitted):
# CLAUDE_PLUGIN_REPO_1=https://github.com/owner/marketplace.git
# CLAUDE_PLUGIN_NAME_1=PluginA,PluginB   # comma-separated; multiple plugins
# CLAUDE_PLUGIN_MARKETPLACE_1=acme       # marketplace.json "name"; optional if unique
# CLAUDE_PLUGIN_SCOPE_1=user             # user, project, or local (default: user)
# CLAUDE_PLUGIN_BRANCH_1=main            # git branch/tag to clone (default: main)
# CLAUDE_PLUGIN_GIT_TOKEN_1=token        # optional, per-repo private-repo token
#
# CLAUDE_PLUGIN_REPO_2=https://github.com/other/marketplace.git
# CLAUDE_PLUGIN_NAME_2=PluginC
#
# Legacy single-repo form (no suffix) is still honored as one additional entry:
# CLAUDE_PLUGIN_REPO=https://github.com/owner/marketplace.git
# CLAUDE_PLUGIN_NAME=MonSemi
# CLAUDE_PLUGIN_MARKETPLACE=monsemi  # marketplace.json "name"; optional if unique
# CLAUDE_PLUGIN_SCOPE=user           # user, project, or local
# CLAUDE_PLUGIN_BRANCH=main          # git branch/tag to clone (default: main)
#
# CLAUDE_PLUGIN_CLAUDE_BIN=          # optional; defaults to PATH or SDK bundled claude
# CLAUDE_PLUGIN_CLONE_ROOT=          # optional; clone root (default ~/.claude/plugin-marketplaces)
# CLAUDE_PLUGIN_TIMEOUT_SECONDS=300  # optional; per git/claude call timeout (default 300)
#
# For private HTTPS plugin repos, set a token. The installer feeds it to git
# through a temporary askpass helper instead of embedding secrets in the URL,
# and it is never passed to the claude CLI.
# CLAUDE_PLUGIN_GIT_TOKEN=your-personal-access-token
#
# Admin-managed plugin manifest layered on top of the CLAUDE_PLUGIN_* env
# bootstrap above. The admin panel records plugins/marketplaces it installs (and
# env-bootstrap plugins it uninstalls) into this JSON file. At startup
# install_plugins.py reconciles the effective set as
# (env bootstrap ∪ manifest.added) minus manifest.removed, so admin changes
# survive container restarts and `docker compose down -v`. In Docker the file
# lives on the ./data bind mount; default /app/data/gateway-plugins.json.
# Note: git tokens are NEVER written to the manifest. A PRIVATE marketplace
# added via the admin panel replays on startup only if the un-indexed
# CLAUDE_PLUGIN_GIT_TOKEN (above) is set — manifest entries inherit it as their
# clone credential. A public marketplace needs no token.
# CLAUDE_PLUGIN_MANIFEST=/app/data/gateway-plugins.json
#
# install_plugins.py also writes an env-bootstrap journal beside the manifest
# (gateway-plugins-env.json) recording each CLAUDE_PLUGIN_* marketplace's
# scope/branch/remote — metadata known_marketplaces.json does not persist for a
# clone-then-add marketplace — so the admin catalog targets the right scope and
# replays the right branch/repo. Auto-managed; override its path only if needed.
# CLAUDE_PLUGIN_ENV_JOURNAL=/app/data/gateway-plugins-env.json
#
# Marketplace auto-refresh (periodic re-clone + `claude plugin update` for every
# gateway-managed marketplace, between container restarts) is configured from
# the admin dashboard's Plugins tab, not via env vars. The toggle + interval
# persist in the manifest's auto_refresh record and apply without a restart.
#
# Claude SDK setting sources. Non-Docker runtime defaults to project,local.
# Docker Compose defaults this to user,project,local so user-scope plugins
# installed at container startup are visible to Claude.
# CLAUDE_SETTING_SOURCES=user,project,local
#
# Host CA bundle mounted into the container's Debian CA path so git/curl/Python
# use the same trusted roots as the host. Default is Ubuntu/Debian.
HOST_CA_CERTIFICATES_PATH=/etc/ssl/certs/ca-certificates.crt

# Docker runtime uid/gid used after startup permission repair. Defaults match
# the common Linux developer user. Set these to `id -u` / `id -g` if your host
# bind-mounted ./data directory is owned by a different uid/gid.
# APP_UID=1000
# APP_GID=1000

# Server Configuration
PORT=8000
# Host binding address - use 127.0.0.1 for local-only access, 0.0.0.0 for all interfaces
# GATEWAY_HOST=0.0.0.0
#
# Legacy: CLAUDE_WRAPPER_HOST is still honored when GATEWAY_HOST is unset.
# Maximum request body size in bytes (default: 10MB)
# MAX_REQUEST_SIZE=10485760

# Timeout Configuration (milliseconds)
MAX_TIMEOUT=600000

# Wall-clock cap for one background (background: true) turn, in seconds.
# A background turn has no HTTP connection to bound it; this stops a wedged
# backend from holding the session lock forever. Default: 3600.
# BACKGROUND_RESPONSE_TIMEOUT_S=3600

# CORS Configuration
CORS_ORIGINS=["*"]

# Model Configuration
# Default Claude model to use when none specified in request
DEFAULT_MODEL=sonnet

# Backend Configuration
# Default is Claude only. OpenCode and Codex are STALE (frozen 2026-07,
# unmaintained): enabling them logs a startup warning and they may break
# without notice.
# Backend is selected by model ID:
#   sonnet/opus/haiku               -> Claude
#   opencode/<provider>/<model>     -> OpenCode
#   codex/<model>                   -> Codex
# BACKENDS=claude
# BACKENDS=claude,opencode
# BACKENDS=claude,codex

# Text-only model denylist for image input (vision capability gating).
# When LiteLLM (or any proxy) routes one Anthropic endpoint to many models,
# image input sent to a model without vision fails late upstream (or is
# silently dropped). List text-only models here to reject image input for
# them up front with a 400. Comma-separated, fnmatch globs, case-insensitive;
# matched against the resolved provider_model first, then the public model.
# Empty (default) = no model is gated.
# TEXT_ONLY_MODELS=o1-mini,deepseek-*,gpt-4o-mini-tts

# OpenCode Backend Configuration (STALE — frozen 2026-07, unmaintained)
#
# Two operating modes:
#   managed (default)  Gateway spawns `opencode serve` as a subprocess and
#                      feeds it OPENCODE_CONFIG_CONTENT + the gateway MCP_CONFIG
#                      (when OPENCODE_USE_WRAPPER_MCP_CONFIG=true).
#   external           Set OPENCODE_BASE_URL to point at an externally-managed
#                      `opencode serve`. Use this when OpenCode must run on a
#                      trusted host with broader filesystem access while the
#                      gateway itself is sandboxed. In external mode the
#                      OPENCODE_CONFIG_CONTENT, OPENCODE_USE_WRAPPER_MCP_CONFIG,
#                      and OPENCODE_BIN/HOST/PORT/START_TIMEOUT_MS variables
#                      are no-ops; the external server owns its own config.
# OPENCODE_BASE_URL=http://opencode-host:7891

# Managed-mode subprocess controls (ignored in external mode)
# OPENCODE_BIN=opencode
# OPENCODE_HOST=127.0.0.1
# OPENCODE_PORT=0
# OPENCODE_START_TIMEOUT_MS=5000

# Request-time options (apply in both modes)
# OPENCODE_AGENT=general
# OPENCODE_DEFAULT_MODEL=openai/gpt-5.5
# Managed mode exposes OpenCode's question tool by default.
# Set to deny to hide it, or allow to enable without permission prompts.
# OPENCODE_QUESTION_PERMISSION=ask

# Basic-auth credentials for the OpenCode server (apply in both modes)
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# Managed-mode config injection (ignored in external mode)
# OPENCODE_CONFIG_CONTENT=
# Include validated gateway MCP_CONFIG in managed OpenCode config.
# OPENCODE_USE_WRAPPER_MCP_CONFIG=false

# Public model allowlist returned by /v1/models (gateway-side, both modes)
# OPENCODE_MODELS=openai/gpt-5.5,openai/gpt-5.5-fast,openai/gpt-5.4,openai/gpt-5.4-mini,opencode/gpt-5-nano

# Optional live OpenCode smoke test settings
# OPENCODE_SMOKE_ENABLED=0
# OPENCODE_SMOKE_MODEL=openai/gpt-5.5
# OPENCODE_SMOKE_CWD=/path/to/workspace

# Codex Backend Configuration (STALE — frozen 2026-07, unmaintained)
# Requires the local Codex CLI app-server harness.
# CODEX_BIN=codex
# CODEX_MODELS=gpt-5.5
# CODEX_DEFAULT_GATEWAY_MODEL=codex/gpt-5.5
# CODEX_APPROVAL_POLICY=never
# CODEX_SANDBOX=danger-full-access
# CODEX_CONFIG_OVERRIDES=

# SDK Configuration
# Maximum conversation turns per request
# DEFAULT_MAX_TURNS=10

# Server-default permission mode applied when a request omits permission_mode.
# Per-request body.permission_mode overrides this. Valid values:
#   default, acceptEdits, bypassPermissions, plan
# Unset = pass None through (backend default). Note: tool blocking is enforced
# via DISALLOWED_TOOLS, not this mode.
# PERMISSION_MODE=default

# ============================================================================
# System Prompt Configuration
# ============================================================================
# Path to a text file (.txt/.md) containing a custom system prompt.
# When set, replaces the claude_code preset entirely.
# Can also be configured at runtime via /admin UI.
#
# DOCKER: a host path here is NOT visible inside the container. Instead set
# SYSTEM_PROMPT_HOST_FILE below to your host file — docker-compose mounts it
# read-only and auto-points SYSTEM_PROMPT_FILE at it for you. (The compose
# environment block overrides SYSTEM_PROMPT_FILE, so setting it here has no
# effect under Docker.)
#   SYSTEM_PROMPT_HOST_FILE=/home/me/my-system-prompt.md
#
# NON-DOCKER (running the gateway directly): set the path here instead.
# SYSTEM_PROMPT_FILE=docs/claude-code-system-prompt-reference.md

# Placeholder values resolved in system prompt {{PLACEHOLDER}} tokens.
# These are substituted when the prompt file is loaded.
# PROMPT_LANGUAGE=Korean
#
# Auto-detected placeholders (no env var needed):
#   {{WORKING_DIRECTORY}} ← per-request workspace cwd
#   {{MEMORY_PATH}}       ← <cwd>/.memory (auto-created per request)
#   {{PLATFORM}}          ← sys.platform (auto)
#   {{SHELL}}             ← $SHELL (auto)
#   {{OS_VERSION}}        ← platform.platform() (auto)

# Thinking Mode: adaptive (default, recommended), enabled (fixed budget), disabled
# THINKING_MODE=adaptive
# Budget tokens for "enabled" mode (ignored for adaptive/disabled)
# THINKING_BUDGET_TOKENS=10000

# Task budget (tokens) — global default for all requests.
# The model paces tool use and wraps up before exceeding this limit.
# Per-request task_budget in the API body overrides this value.
# TASK_BUDGET=

# Token-level streaming (true=stream individual tokens, false=wait for complete messages)
# TOKEN_STREAMING=true

# Disallowed Subagent Types (comma-separated)
# Block specific built-in subagent types via Agent(type) syntax
# Available types: general-purpose, Explore, Plan, statusline-setup
# DISALLOWED_SUBAGENT_TYPES=statusline-setup

# Disallowed Tools (comma-separated)
# Block specific Claude SDK tools regardless of request allowed_tools or
# permission_mode. Necessary because the gateway runs in bypassPermissions
# mode, where allowed_tools acts only as an auto-approve hint and does not
# strictly restrict tool use. Unset by default (no extra blocking).
# Denying a plain tool removes it from the model's tool surface entirely —
# it disappears from the listing, unlike skills. Works for regular tools
# (WebFetch, WebSearch) and harness/orchestration tools (ScheduleWakeup,
# ShareOnboardingGuide, CronCreate/CronDelete/CronList, DesignSync,
# NotebookEdit, RemoteTrigger, ...).
# Skills are not tool names: block one skill with Skill(<name>), every skill
# with Skill. A bare skill name (e.g. deep-research) matches nothing (no-op).
# DISALLOWED_TOOLS=WebFetch,WebSearch,Skill(deep-research)
# DISALLOWED_TOOLS=WebFetch,WebSearch,ScheduleWakeup,ShareOnboardingGuide,CronCreate,CronDelete,CronList,DesignSync,NotebookEdit,RemoteTrigger,Skill(deep-research)

# Blocked Slash Commands (comma-separated, leading slash optional)
# Client-typed slash commands rejected with 400 blocked_command, merged with
# the always-blocked destructive built-ins (/compact, /init, /heapdump).
# Skill(<name>) in DISALLOWED_TOOLS covers the model-initiated path; this
# covers the client-typed /name path — set both to fully disable a skill.
# BLOCKED_SLASH_COMMANDS=deep-research,verify,code-review,run,security-review

# Hidden Skills (comma-separated, leading slash optional)
# Removes skills from the model's catalog: the gateway converts the SDK
# ``skills`` option into an allowlist of discovered commands minus this set,
# so unlisted skills disappear from the system prompt and are rejected at
# Skill-tool dispatch. Blocking alone (Skill(<name>) deny) stops execution
# but the model still sees the skill listed — to fully disable a skill set
# all three: HIDDEN_SKILLS (catalog), DISALLOWED_TOOLS Skill(<name>)
# (execution backstop), BLOCKED_SLASH_COMMANDS (client-typed /name input).
# HIDDEN_SKILLS=deep-research,verify,code-review,run,security-review

# Subagent Streaming Visibility
# Control which subagent outputs are forwarded to the client during streaming.
# SUBAGENT_STREAM_TEXT: Forward subagent text deltas (default: false — only final summary)
# SUBAGENT_STREAM_TOOL_BLOCKS: Forward subagent tool_use/tool_result blocks (default: true)
# SUBAGENT_STREAM_PROGRESS: Forward task_started/progress/notification events (default: true)
# SUBAGENT_STREAM_TEXT=false
# SUBAGENT_STREAM_TOOL_BLOCKS=true
# SUBAGENT_STREAM_PROGRESS=true

# Experimental: Agent Teams (multi-agent teammates)
# Enable the Claude CLI's experimental agent-team mode, where the model can
# spawn coordinating teammates (TeamCreate/TeamDelete/SendMessage tools plus a
# shared task list). OFF by default and NOT listed in the tool catalog; the
# gateway never sets this, so you must export it on the gateway process env.
# May also require a server-side (statsig) feature gate on your account, so the
# env var alone is not always sufficient. Once active, teammate activity
# surfaces through the SUBAGENT_STREAM_* channels above (task_started/progress/
# updated) and the team tools are auto-approved like any other tool.
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Liveness / "still working" progress signals (Responses API streaming)
# Forward extra events so a UI can show activity in the gaps between text —
# long tool-call generation, hook runs, and context compaction.
# STREAM_TOOL_PROGRESS: Emit response.tool_use_started at a tool call's start,
#   before its arguments finish streaming (default: true).
# STREAM_HOOK_EVENTS: Enable the SDK's include_hook_events and forward hook
#   lifecycle (PreToolUse/PostToolUse/Stop/…) as response.hook_event (default: true).
# STREAM_COMPACTION_EVENTS: Forward context-compaction (compact_boundary) as
#   response.compaction (default: true).
# STREAM_TOOL_PROGRESS=true
# STREAM_HOOK_EVENTS=true
# STREAM_COMPACTION_EVENTS=true

# Bash Sandbox (OS-level process isolation for Bash tool execution)
# Tri-state: unset = respect project-level settings, true = force enable, false = force disable
# Only affects Bash commands; Read/Edit/Write access is controlled by SDK permission rules.
# Requires macOS (Seatbelt) or Linux (bubblewrap). Not supported on Windows.
# CLAUDE_SANDBOX_ENABLED=true
# Auto-approve bash commands when sandboxed (default: true)
# CLAUDE_SANDBOX_AUTO_ALLOW_BASH=true
# Commands that bypass the sandbox (comma-separated, default: none)
# CLAUDE_SANDBOX_EXCLUDED_COMMANDS=
# Allow model to request unsandboxed execution via dangerouslyDisableSandbox (default: false)
# CLAUDE_SANDBOX_ALLOW_UNSANDBOXED=false
# Allow binding to local network ports inside sandbox (default: false)
# CLAUDE_SANDBOX_NETWORK_ALLOW_LOCAL=false
# Enable weaker sandbox for unprivileged Docker containers on Linux (default: false)
# CLAUDE_SANDBOX_WEAKER_NESTED=false

# Per-workspace sandbox (PreToolUse hook confining file/Bash paths to the
# session workspace root). Defends against cross-user access under the shared
# workspace root that cwd/acceptEdits do not enforce. Default: disabled.
# When enabled and CLAUDE_SANDBOX_ENABLED is unset, the OS-level bash sandbox
# above is force-enabled as a defense-in-depth backstop for runtime shell
# expansions ($VAR, command substitution) the hook cannot resolve statically.
# WORKSPACE_SANDBOX_ENABLED=true
# Categories permitted to reach paths OUTSIDE the workspace (comma-separated:
# read / write / bash). Empty = confine everything. Default: empty.
# WORKSPACE_SANDBOX_ALLOW_OUTSIDE=

# SSE keepalive interval in seconds (prevents connection drops during long SDK operations)
# Set to 0 to disable. Default: 15
# SSE_KEEPALIVE_INTERVAL=15

# Session Management
# SESSION_CLEANUP_INTERVAL_MINUTES=5
# SESSION_MAX_AGE_MINUTES=60

# AskUserQuestion hook timeout (seconds).
# If the client does not respond within this window the hook denies the
# tool call and the SDK resumes. Default: 300 (5 minutes).
# ASK_USER_TIMEOUT_SECONDS=300

# MCP Server Configuration
# Path to MCP config JSON file or inline JSON string
# Format: {"mcpServers": {"name": {"type": "stdio|sse|http|streamable-http", ...}}}
# MCP_CONFIG={"mcpServers": {"filesystem": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"]}}}
# MCP_CONFIG=/path/to/mcp-config.json
#
# Per-server env (stdio) and headers (http/sse/streamable-http) are stored on
# that MCP config only — never merged into the gateway process environment.
# Values may reference gateway env vars with {{env:NAME}}, resolved at Claude/
# Codex session create or OpenCode managed startup (not at admin save time):
#   "env": {"GITHUB_TOKEN": "{{env:GITHUB_TOKEN}}"}
#   "headers": {"Authorization": "Bearer {{env:MCP_TOKEN}}"}
#
# Admin-managed MCP server manifest (data/gateway-mcp.json on the ./data bind
# mount). MCP_CONFIG stays the base/default; this manifest layers on top
# (manifest wins on name collision). Admin panel CRUD writes here and changes
# HOT-RELOAD into NEW sessions (Claude/Codex). OpenCode reads MCP only at
# managed-server startup behind OPENCODE_USE_WRAPPER_MCP_CONFIG — restart needed.
# GATEWAY_MCP_MANIFEST=/app/data/gateway-mcp.json
#
# Admin-managed credential overlays for *plugin-provided* MCP servers
# (env/headers only; plugin command/url stay in the plugin). Hot-reloads into
# NEW Claude sessions. The merged config replaces the plugin's own server
# registration (verified on the pinned SDK's CLI), and overlay values stay
# scoped to the MCP server process — they are NOT injected into the session
# process environment. Overlays whose plugin is no longer installed are
# skipped entirely. Path override:
# GATEWAY_MCP_PLUGIN_OVERLAY=/app/data/gateway-mcp-plugin-overlay.json
#
# Deploy-time version of the same credential overlay, keyed by MCP server name:
# env/headers for ONE named server, declared here instead of clicked into the
# admin panel. Inline JSON or a path to a JSON file (same dual form as
# MCP_CONFIG), so a docker/K8s secret can be mounted and pointed at.
#   {"<server>": {"env": {...}, "headers": {...}}}
# Values may use {{env:NAME}} like any other MCP env/header, which keeps the
# actual secret in a plain gateway env var instead of in this JSON.
# Resolution per server name at Claude session create: an installed plugin that
# declares the name wins (overlay merges onto the plugin's command/url), else the
# gateway MCP_CONFIG/manifest server of that name gets the merge; a name neither
# declares logs a warning and is skipped. The admin overlay file wins per key, so
# these are defaults an operator can hot-fix from the panel. Values stay scoped to
# the MCP server process — never injected into the session process environment.
# Read at startup and on any admin overlay save/delete, so a file-backed layer
# picks up edits on the next such reload (or a gateway restart), not on its own.
# Claude backend only (the stale codex/opencode backends ignore this layer).
# GATEWAY_MCP_SERVER_ENV={"context7":{"env":{"CONTEXT7_API_KEY":"{{env:CONTEXT7_API_KEY}}"}}}
# GATEWAY_MCP_SERVER_ENV=/run/secrets/mcp-server-env.json

# Metadata env var passthrough (comma-separated allowlist)
# Only metadata keys listed here are forwarded as env vars to the Claude subprocess.
# Callers send these via the "metadata" field in /v1/responses requests.
# Example: a2a-agent sends metadata={"THREAD_ID": "abc"} on every turn.
METADATA_ENV_ALLOWLIST=THREAD_ID,ORCHESTRATOR_URL

# Debugging
# DEBUG_MODE=false
# VERBOSE=false

# Startup configuration validation escape hatch. The server fails fast on
# contradictory configuration (see src/config_check.py). Set to true to log the
# issues as warnings and start anyway — for operators who accept the flagged
# config. Default: false.
# SKIP_CONFIG_CHECK=false

# ============================================================================
# Admin UI Configuration
# ============================================================================
# Web-based admin dashboard at /admin for managing workspace files,
# viewing config, monitoring sessions, and checking backend status.

# Admin API key (REQUIRED — server will not start without it)
# This is independent from the gateway API_KEY — admin is a higher-privilege surface.
# ADMIN_API_KEY=your-secure-admin-key-here

# Admin session TTL in seconds (default: 3600 = 1 hour)
# ADMIN_SESSION_TTL=3600

# Admin session cookie is marked Secure (HTTPS-only) by default.
# Set to false for local HTTP development to allow the cookie over plain HTTP.
# ADMIN_COOKIE_SECURE=true

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_DEBUG_PER_MINUTE=2
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=5
RATE_LIMIT_SESSION_PER_MINUTE=15
RATE_LIMIT_HEALTH_PER_MINUTE=30
RATE_LIMIT_RESPONSES_PER_MINUTE=10

# ============================================================================
# Docker Build-Time Options (consumed by `docker compose build`, not runtime)
# ============================================================================
# These are NOT read by the server at runtime. docker-compose.yml picks them
# up at build time via build.args. Leave unset on public networks.

# Debian apt mirror used for system packages inside the gateway image.
# The Dockerfile pins python:3.12-slim-trixie, so the mirror must serve
# trixie, trixie-updates, and trixie-security.
# APT_MIRROR_URL=http://apt-mirror.example.com/debian

# Optional separate Debian security mirror. If unset, APT_MIRROR_URL is used
# for the security source as well.
# APT_SECURITY_MIRROR_URL=http://apt-mirror.example.com/debian-security

# npm registry used to install the managed OpenCode binary package.
# The mirror must contain opencode-ai, @openai/codex, and the matching
# platform packages for OPENCODE_VERSION/CODEX_VERSION.
# NPM_CONFIG_REGISTRY=https://npm.example.com/repository/npm/

# OpenCode npm package version installed into the Docker image. A host environment
# value or .env value overrides the Dockerfile default.
# OPENCODE_VERSION=1.14.29

# Codex npm package version installed into Dockerfile.codex. A host environment
# value or .env value overrides the Dockerfile.codex default.
# CODEX_VERSION=0.130.0

# Private PyPI mirror (e.g. internal Nexus). When set, pip fetches packages
# from this index instead of pypi.org.
# PIP_INDEX_URL=https://nexus.example.com/repository/pypi/simple/

# Additional pip index, searched after PIP_INDEX_URL.
# PIP_EXTRA_INDEX_URL=https://extra-index.example.com/simple/

# Required when the pip mirror is served over plain HTTP — pip silently
# ignores HTTP indexes otherwise. Use the bare hostname (no scheme/path).
# Space-separated for multiple hosts.
# PIP_TRUSTED_HOST=nexus.example.com

# Optional local install script executed during Docker image build as root.
# The file is mounted as a BuildKit secret, not copied into the image or repo.
# Leave unset to run the built-in no-op hook.
# GATEWAY_BUILD_INSTALL_SCRIPT=/opt/company/install_gateway_addons.sh
# Bump this value, or build with --no-cache, after changing the script.
# GATEWAY_BUILD_INSTALL_CACHE_BUST=2026-05-25

# HTTP(S) proxy for the build (apt-get, npm, pip, image pulls).
# Docker treats these as predefined proxy ARGs — not baked into image history.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.example.com

# ---------------------------------------------------------------------------
# Usage logging (optional)
# ---------------------------------------------------------------------------
# When USAGE_LOG_DB_URL is set, the gateway writes one row per /v1/responses
# turn into the configured database (see docker-compose `logging` profile
# for a ready-to-run MySQL sidecar). Timestamps are stored in UTC; admin usage
# date filters, buckets, and displayed turn times use KST. Leave unset to disable.
# Before upgrading a database with existing rows, verify that the old runtime
# wrote UTC timestamps; legacy process-local timestamps cannot be auto-detected.
#
# URL is a SQLAlchemy URL.  These shorthands are auto-mapped to the async
# driver (driver must be installed):
#   mysql://...       -> mysql+aiomysql://...      (aiomysql, bundled)
#   sqlite://...      -> sqlite+aiosqlite://...    (install aiosqlite)
# USAGE_LOG_DB_URL=mysql://gateway:gateway@gateway-log:3306/gateway_log
# USAGE_LOG_DB_URL=sqlite+aiosqlite:///./data/gateway_log.sqlite

# Credentials used by the `gateway-log` MySQL sidecar in docker-compose.yml.
# Override these in production deployments.
# GATEWAY_LOG_MYSQL_ROOT_PASSWORD=gateway_root
# GATEWAY_LOG_MYSQL_USER=gateway
# GATEWAY_LOG_MYSQL_PASSWORD=gateway
# GATEWAY_LOG_MYSQL_DATABASE=gateway_log
# GATEWAY_LOG_PORT=3306
#
# The `gateway-log` MySQL sidecar lives behind the `logging` compose profile, so
# it only starts when that profile is active. Activate it either with the CLI
# flag (`docker compose --profile logging up -d`) or by setting this Compose
# built-in here so plain `docker compose up -d` includes it. Read by Docker
# Compose at parse-time only; not used by the application itself.
# COMPOSE_PROFILES=logging
